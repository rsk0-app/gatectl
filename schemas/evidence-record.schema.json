{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "type": { "enum": ["TEST", "BUILD", "LINT", "TYPECHECK", "REVIEW", "DIFF", "RUNTIME", "SECURITY", "MIGRATION", "OTHER"] },
    "producer_run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "feature_id": { "type": "string", "minLength": 1 },
    "spec_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "commit_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{7,64}$" },
    "test_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "dependency_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "configuration_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "policy_version": { "type": ["string", "integer"] },
    "command": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "environment_id": { "type": "string", "minLength": 1 },
    "artifact_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "requirement_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "test_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "freshness": { "enum": ["FRESH", "STALE"] }
  },
  "required": [
    "evidence_id",
    "type",
    "producer_run_id",
    "created_at",
    "feature_id",
    "spec_digest",
    "commit_sha",
    "test_digest",
    "dependency_digest",
    "configuration_digest",
    "policy_version",
    "environment_id",
    "artifact_digest",
    "artifact_ref",
    "requirement_ids",
    "test_ids",
    "freshness"
  ]
}
