{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uncertainty",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "state": {
      "enum": [
        "KNOWN",
        "INFERRED",
        "ASSUMED",
        "UNKNOWN"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "statement",
    "state",
    "blocking"
  ]
}