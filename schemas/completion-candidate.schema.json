{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompletionCandidate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "feature_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "spec_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "commit_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{7,64}$" },
    "status": { "const": "READY_FOR_VERIFICATION" },
    "implementer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      },
      "required": ["run_id", "provider", "model"]
    },
    "requirement_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "claim": { "enum": ["IMPLEMENTED", "PARTIAL", "BLOCKED", "NOT_APPLICABLE"] },
          "code_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "test_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "waiver_id": { "type": ["string", "null"] }
        },
        "required": ["requirement_id", "claim", "code_refs", "test_refs", "evidence_refs"]
      }
    },
    "validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "artifact_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
        },
        "required": ["command", "exit_code", "artifact_digest"]
      }
    },
    "changed_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "remaining_work": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "deviations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "scope_changes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "required": [
    "candidate_id",
    "feature_id",
    "task_id",
    "spec_digest",
    "commit_sha",
    "status",
    "implementer",
    "requirement_claims",
    "validation_results",
    "changed_files",
    "remaining_work",
    "blockers",
    "deviations",
    "scope_changes",
    "evidence_refs"
  ]
}
