{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "feature_id": { "type": "string", "minLength": 1 },
    "spec_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "commit_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{7,64}$" },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "independent_from_implementation_run": { "const": true },
        "opposite_provider": { "type": "boolean" }
      },
      "required": ["run_id", "provider", "model", "independent_from_implementation_run", "opposite_provider"]
    },
    "decision": { "enum": ["VERIFIED", "REWORK_REQUIRED", "BLOCKED", "NEEDS_HUMAN"] },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_digest_matches": { "type": "boolean" },
        "commit_sha_matches": { "type": "boolean" },
        "traceability_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "must_requirements_verified_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "required_evidence_fresh_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "deterministic_validations_passed": { "type": "boolean" },
        "acceptance_tests_unchanged_or_approved": { "type": "boolean" },
        "scope_matches_declaration": { "type": "boolean" }
      },
      "required": [
        "spec_digest_matches",
        "commit_sha_matches",
        "traceability_coverage_percent",
        "must_requirements_verified_percent",
        "required_evidence_fresh_percent",
        "deterministic_validations_passed",
        "acceptance_tests_unchanged_or_approved",
        "scope_matches_declaration"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["SPEC_GAP", "IMPLEMENTATION_GAP", "VERIFICATION_GAP", "NEW_SCOPE"] },
          "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "blocking": { "type": "boolean" },
          "requirement_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "summary": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["id", "classification", "severity", "blocking", "requirement_ids", "summary", "evidence_refs"]
      }
    },
    "unresolved_blocking_findings": { "type": "integer", "minimum": 0 },
    "unapproved_waivers": { "type": "integer", "minimum": 0 },
    "undeclared_scope_changes": { "type": "integer", "minimum": 0 },
    "repair_loop": { "type": "integer", "minimum": 0 },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "required": [
    "report_id",
    "candidate_id",
    "feature_id",
    "spec_digest",
    "commit_sha",
    "verifier",
    "decision",
    "checks",
    "findings",
    "unresolved_blocking_findings",
    "unapproved_waivers",
    "undeclared_scope_changes",
    "repair_loop",
    "evidence_refs"
  ],
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "VERIFIED" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "checks": {
            "properties": {
              "spec_digest_matches": { "const": true },
              "commit_sha_matches": { "const": true },
              "traceability_coverage_percent": { "const": 100 },
              "must_requirements_verified_percent": { "const": 100 },
              "required_evidence_fresh_percent": { "const": 100 },
              "deterministic_validations_passed": { "const": true },
              "acceptance_tests_unchanged_or_approved": { "const": true },
              "scope_matches_declaration": { "const": true }
            }
          },
          "unresolved_blocking_findings": { "const": 0 },
          "unapproved_waivers": { "const": 0 },
          "undeclared_scope_changes": { "const": 0 }
        }
      }
    }
  ]
}
